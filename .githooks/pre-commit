#!/usr/bin/env bash
set -euo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

./scripts/check-protected-inputs.sh

if ! command -v pnpm >/dev/null 2>&1; then
  printf '%s\n' 'MAKO pre-commit: pnpm is required to format staged Markdown.' >&2
  exit 1
fi

if [[ ! -x plugin/node_modules/.bin/lint-staged ]]; then
  printf '%s\n' 'MAKO pre-commit: install plugin dependencies with `pnpm --dir plugin install --frozen-lockfile`.' >&2
  exit 1
fi

pnpm --dir plugin run format:staged
