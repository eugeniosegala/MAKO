{
  "name": "mako-website",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "check:legal": "node scripts/check-legal-notices.mjs",
    "check:release-contract": "node scripts/check-release-contract.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "build": "npm run check:release-contract && npm run check:legal && vinext build",
    "dev:pages": "vite --config vite.pages.config.ts",
    "build:pages": "npm run check:release-contract && npm run check:legal && vite build --config vite.pages.config.ts && npm run check:seo",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261028.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.3.1",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "type": "module"
}
