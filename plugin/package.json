{
  "name": "mako-plugin",
  "version": "2.0.0",
  "description": "MAKO Decky controls for Steam Deck and compatible Linux systems",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "watch": "rollup -c -w",
    "package:local": "./scripts/package-local.sh --local-engine-repo ../engine",
    "package:local-engine": "./scripts/package-local.sh --local-engine-repo ../engine",
    "package:local-engine-fast": "./scripts/package-local.sh --local-engine-repo ../engine --native-only --64-bit-only",
    "dev:deploy": "./scripts/deploy-dev.sh",
    "dev:reload": "node scripts/reload-decky-plugin.mjs",
    "dev:frontend": "./scripts/deploy-dev.sh --frontend",
    "dev:backend": "./scripts/deploy-dev.sh --backend",
    "dev:backend:reload": "./scripts/deploy-dev.sh --backend --reload",
    "dev:engine": "./scripts/deploy-dev.sh --engine",
    "dev:all": "./scripts/deploy-dev.sh --all",
    "dev:host": "./scripts/deploy-dev.sh --host",
    "dev:flatpaks": "./scripts/deploy-dev.sh --flatpaks",
    "dev:e2e": "./scripts/deploy-dev.sh --e2e",
    "dev:prune-build-cache": "../engine/scripts/prune-build-cache.sh",
    "dev:prune-flatpak-cache": "../engine/scripts/prune-steamos-flatpak-cache.sh",
    "package:publish": "./scripts/publish-package.sh",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:frontend": "vitest run",
    "test:frontend:coverage": "vitest run --coverage",
    "test:frontend:typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugeniosegala/MAKO.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "steam-machine",
    "deck",
    "lossless-scaling",
    "frame-generation",
    "framegen"
  ],
  "author": "Eugenio Segala",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/eugeniosegala/MAKO/issues"
  },
  "homepage": "https://github.com/eugeniosegala/MAKO#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.22.5",
    "@rollup/rollup-linux-x64-musl": "4.22.5"
  },
  "remote_binary_bundling": true,
  "remote_binary": [
    {
      "name": "mako-render-v2.0.0-linux.tar.xz",
      "version": "2.0.0",
      "lineage_version": "2.0.0",
      "source_repository": "https://github.com/eugeniosegala/MAKO",
      "release_tag": "render-v2.0.0",
      "source_commit": "00a830e4ab6acc167a591cd7508df1af8f7037c9",
      "url": "https://github.com/eugeniosegala/MAKO/releases/download/render-v2.0.0/mako-render-v2.0.0-linux.tar.xz",
      "sha256hash": "31b4652cd589921fdc67f42f76ed98fee0e0e7a94b275d7fa7e5cb13b02f22d7",
      "host_architectures": [
        "x86_64"
      ],
      "flatpak_bundle": {
        "name": "mako-render-v2.0.0-flatpaks.tar.xz",
        "url": "https://github.com/eugeniosegala/MAKO/releases/download/render-v2.0.0/mako-render-v2.0.0-flatpaks.tar.xz",
        "sha256hash": "0b5b39377e838acacea809bed6250d68043ba3845df06527c275a346fb56805c"
      }
    }
  ]
}
