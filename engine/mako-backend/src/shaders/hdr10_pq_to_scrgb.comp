#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 16) uniform sampler sourceSampler;
layout(set = 0, binding = 32) uniform texture2D sourceTexture;
layout(rgba16f, set = 0, binding = 48) uniform writeonly image2D destinationImage;

const float pqM1 = 2610.0 / 16384.0;
const float pqM2 = 2523.0 / 32.0;
const float pqC1 = 3424.0 / 4096.0;
const float pqC2 = 2413.0 / 128.0;
const float pqC3 = 2392.0 / 128.0;

vec3 pqToLinear(vec3 encoded) {
    vec3 p = pow(clamp(encoded, 0.0, 1.0), vec3(1.0 / pqM2));
    vec3 numerator = max(p - vec3(pqC1), vec3(0.0));
    vec3 denominator = max(vec3(pqC2) - vec3(pqC3) * p, vec3(1e-6));
    return pow(numerator / denominator, vec3(1.0 / pqM1));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destinationImage);
    if (any(greaterThanEqual(pixel, size)))
        return;

    vec4 encoded = texelFetch(sampler2D(sourceTexture, sourceSampler), pixel, 0);
    vec3 linear2020 = pqToLinear(encoded.rgb);
    const mat3 bt2020ToBt709 = mat3(
         1.660491, -0.124550, -0.018151,
        -0.587641,  1.132900, -0.100579,
        -0.072850, -0.008349,  1.118730
    );

    // ST 2084 is normalized to 10,000 nits; scRGB 1.0 represents 80 nits.
    vec3 scrgb = bt2020ToBt709 * linear2020 * 125.0;
    imageStore(destinationImage, pixel, vec4(scrgb, encoded.a));
}
