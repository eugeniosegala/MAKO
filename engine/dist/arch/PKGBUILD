# Maintainer: xidongbot <xidong-ai@foxmail.com>
# Upstream: https://github.com/eugeniosegala/MAKO
#
# This PKGBUILD repackages the official prebuilt MAKO Renderer host archive
# (MAKO-Renderer-vX.Y.Z-linux.tar.xz) into a system-wide pacman package.
# It does not build MAKO from source. The upstream ELF binaries and shared
# libraries are installed byte-identical to the release archive so they stay
# verifiable against MAKO-Renderer-install-manifest.txt.
#
# Run check-release-pin.sh next to this file to confirm that pkgver, source
# and sha256sums still match the release pinned in plugin/package.json.

pkgname=mako-renderer-bin
pkgver=3.3.0
pkgrel=1
pkgdesc="Frame generation and spatial scaling Vulkan layers for Linux games"
arch=('x86_64')
url="https://github.com/eugeniosegala/MAKO"
license=('GPL-3.0-or-later')
install="${pkgname}.install"

# Runtime dependencies mapped to the DT_NEEDED entries of the shipped binaries.
# Both layer sets ship 64-bit and 32-bit libraries, hence the lib32 entries.
# bash is intentionally not listed even though /usr/bin/mako-launch and
# /usr/bin/mako-diagnostics are bash scripts: bash is guaranteed by base.
depends=(
    # libc.so.6, libm.so.6, ld-linux-x86-64.so.2
    'glibc'
    # libstdc++.so.6, libgcc_s.so.1
    'gcc-libs'
    # libQt6Core.so.6, libQt6Gui.so.6, libQt6Network.so.6, libQt6OpenGL.so.6, libQt6Quick.so.6
    'qt6-base'
    # libQt6Qml.so.6, libQt6QmlModels.so.6
    'qt6-declarative'
    # libGLX.so.0, libOpenGL.so.0
    'libglvnd'
    # libX11.so.6, used directly by the bundled private vkBasalt layer in
    # releases that include it
    'libx11'
    # fallback icon theme for the desktop entry
    'hicolor-icon-theme'
    # The Vulkan loader dlopens the layers. It is not a DT_NEEDED entry, but the
    # implicit layers are unusable without it.
    'vulkan-icd-loader'
    # 32-bit libc.so.6, libm.so.6, ld-linux.so.2
    'lib32-glibc'
    # 32-bit libstdc++.so.6, libgcc_s.so.1
    'lib32-gcc-libs'
    # 32-bit Vulkan loader for the lib32 layers
    'lib32-vulkan-icd-loader'
    # 32-bit libX11.so.6 for the bundled private vkBasalt layer
    'lib32-libx11'
)

optdepends=(
    'qt6-wayland: native configuration UI under Wayland sessions'
    'vkd3d: LS1 spatial scaling needs libvkd3d-shader.so.1 (64-bit)'
    'lib32-vkd3d: LS1 spatial scaling needs libvkd3d-shader.so.1 (32-bit)'
    'lib32-mesa: Zink support for 32-bit OpenGL games'
)

# Upstream binaries are already stripped and must remain byte-identical to the
# official archive so they can be checked against
# MAKO-Renderer-install-manifest.txt. Do not strip them or generate debug symbols.
options=('!strip' '!debug')

# Treat a future source-built mako-renderer package as the interchangeable
# implementation. Pacman then resolves dependencies against either package and
# removes one before installing the other instead of relying on a late file
# conflict.
provides=("mako-renderer=${pkgver}")
conflicts=('mako-renderer')

source=("MAKO-Renderer-v${pkgver}-linux.tar.xz::https://github.com/eugeniosegala/MAKO/releases/download/render-v${pkgver}/MAKO-Renderer-v${pkgver}-linux.tar.xz")
sha256sums=('ca8d9f8c5537bf92edd68adae31926580b2bfb7e83543bf7a25bc21ac2976e6d')
noextract=("MAKO-Renderer-v${pkgver}-linux.tar.xz")

_mako_install_payload_file() {
    local relative_path="$1"
    local destination_path=""
    local install_mode=644

    case "$relative_path" in
        "" | /* | ../* | */../* | */.. | ./* | */./* | */.)
            printf 'mako-renderer-bin: unsafe archive manifest path: %s\n' "$relative_path" >&2
            return 1
            ;;
    esac
    if [[ ! -f "$relative_path" ]]; then
        printf 'mako-renderer-bin: archive manifest path is missing: %s\n' "$relative_path" >&2
        return 1
    fi

    case "$relative_path" in
        bin/mako-installer | share/applications/io.github.eugeniosegala.mako.uninstaller.desktop)
            # The user-local installer and uninstaller must never manage a
            # pacman-owned system prefix.
            return 0
            ;;
        share/doc/mako-render/LICENSE.md | share/doc/mako-render/THIRD_PARTY_NOTICES.md)
            destination_path="$pkgdir/usr/share/licenses/$pkgname/${relative_path##*/}"
            ;;
        share/doc/mako-render/vkbasalt/LICENSE | share/doc/mako-render/vkbasalt/RESHade-LICENSE.md)
            destination_path="$pkgdir/usr/share/licenses/$pkgname/vkbasalt/${relative_path##*/}"
            ;;
        share/doc/mako-render/*)
            destination_path="$pkgdir/usr/share/doc/$pkgname/${relative_path#share/doc/mako-render/}"
            ;;
        bin/*)
            destination_path="$pkgdir/usr/$relative_path"
            install_mode=755
            ;;
        lib/* | lib32/*)
            destination_path="$pkgdir/usr/$relative_path"
            install_mode=755
            ;;
        share/*)
            destination_path="$pkgdir/usr/$relative_path"
            ;;
        *)
            printf 'mako-renderer-bin: unsupported archive manifest path: %s\n' "$relative_path" >&2
            return 1
            ;;
    esac

    install -Dm"$install_mode" "$relative_path" "$destination_path"
}

prepare() {
    # The archive is noextract so its root files never leak into srcdir. Recreate
    # and verify one private payload copy outside fakeroot on every preparation.
    rm -rf payload
    mkdir -p payload
    tar -xJf "$srcdir/MAKO-Renderer-v${pkgver}-linux.tar.xz" -C payload
    cd "$srcdir/payload"

    if ! sha256sum --check --status MAKO-Renderer-install-manifest.txt; then
        printf '%s\n' 'mako-renderer-bin: archive payload does not match its install manifest' >&2
        return 1
    fi
}

package() {
    cd "$srcdir/payload"

    local required_path
    local required_paths=(
        bin/mako-cli
        bin/mako-diagnostics
        bin/mako-installer
        bin/mako-launch
        bin/mako-ui
        lib/libmako-render-scaling.so
        lib/libmako-render.so
        lib32/libmako-render-scaling.so
        lib32/libmako-render.so
        share/applications/io.github.eugeniosegala.mako.desktop
        share/applications/io.github.eugeniosegala.mako.uninstaller.desktop
        share/doc/mako-render/ASSET_PROVENANCE.md
        share/doc/mako-render/LICENSE.md
        share/doc/mako-render/THIRD_PARTY_NOTICES.md
        share/mako-render/vulkan/implicit_layer.d/VkLayer_MAKO_render.json
        share/mako-render/vulkan/implicit_layer.d/VkLayer_MAKO_render.x86.json
        share/mako-render/vulkan/spatial_scaling.d/VkLayer_MAKO_spatial_scaling.json
        share/mako-render/vulkan/spatial_scaling.d/VkLayer_MAKO_spatial_scaling.x86.json
        share/vulkan/implicit_layer.d/VkLayer_MAKO_render.json
        share/vulkan/implicit_layer.d/VkLayer_MAKO_render.x86.json
        share/vulkan/implicit_layer.d/VkLayer_MAKO_spatial_scaling.json
        share/vulkan/implicit_layer.d/VkLayer_MAKO_spatial_scaling.x86.json
    )
    for required_path in "${required_paths[@]}"; do
        if [[ ! -f "$required_path" ]]; then
            printf 'mako-renderer-bin: required archive payload is missing: %s\n' "$required_path" >&2
            return 1
        fi
    done

    local manifest_line manifest_checksum manifest_path
    while IFS= read -r manifest_line || [[ -n "$manifest_line" ]]; do
        manifest_checksum="${manifest_line%%  *}"
        manifest_path="${manifest_line#*  }"
        if [[ ! "$manifest_checksum" =~ ^[0-9a-f]{64}$ || "$manifest_path" == "$manifest_line" ]]; then
            printf 'mako-renderer-bin: invalid archive manifest entry: %s\n' "$manifest_line" >&2
            return 1
        fi
        _mako_install_payload_file "$manifest_path"
    done < MAKO-Renderer-install-manifest.txt

    # Version and the upstream checksum manifest are outside the installer's
    # managed payload but remain available for package provenance audits.
    install -Dm644 MAKO-Renderer-version.txt "$pkgdir/usr/share/doc/mako-renderer-bin/MAKO-Renderer-version.txt"
    install -Dm644 MAKO-Renderer-install-manifest.txt "$pkgdir/usr/share/doc/mako-renderer-bin/MAKO-Renderer-install-manifest.txt"

    # Deliberately not installed:
    # - bin/mako-installer and "Install MAKO Renderer": the user-local installer,
    #   which targets ~/.local and manages its own renderer copy.
    # - share/applications/io.github.eugeniosegala.mako.uninstaller.desktop: its
    #   Exec calls "mako-installer --uninstall", which defaults to ~/.local and
    #   would delete MAKO Decky's user-local renderer files. It has no meaning
    #   for a pacman-owned package.
    # - README.txt from the archive root: it documents the user-local installer
    #   flow that this package deliberately does not provide.
}
